# ── Large data files ───────────────────────────────────────────────
# Raw / cleaned loan CSVs (too big for GitHub)
*.csv
*.csv.gz

# Keep small result CSVs in the results/ folder
!results/*.csv

# ── Credentials & secrets ──────────────────────────────────────────
.env
.env.*
secrets.yaml
secrets.yml
secrets.json
*password*
*passwords*
*credentials*

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Jupyter ────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS / IDE ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
